generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Challenge {
  id                 String    @id @default(cuid())
  challengerId       String
  targetId           String
  createdAt          DateTime  @default(now())
  reminderSent       Boolean   @default(false)
  challengerResponse String?
  targetResponse     String?
  remindAt           DateTime?
}
